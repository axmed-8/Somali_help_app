# Local tip: use Windows MySQL80 on port 3306.
# Stop XAMPP MySQL if Workbench shows an empty gurmad database.
# Production (Render): Railway MySQL public proxy — prefer project-root .env
# or Render env vars (see render.yaml):
#   MYSQL_HOST=sakura.proxy.rlwy.net
#   MYSQL_PORT=33388
#   MYSQL_USER=root
#   MYSQL_DATABASE=railway
#   MYSQL_PASSWORD=<from Railway — never commit>
# (DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME aliases also work.)
#
# Copy to db_config.env only if you want file-based local credentials.
# db_config.env is gitignored and must never be committed.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gurmad
DB_USER=root
DB_PASSWORD=your_password_here
