# ============================================================
# GurmadNet environment template
# Copy this file to ".env" in the project root and fill values.
#   copy .env.example .env
# Never commit the real .env file.
# ============================================================

SECRET_KEY=generate-a-long-random-value-here
GURMADNET_DB=mysql
APP_NAME=GurmadNet AI

# Session / debug
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=false
WTF_CSRF_ENABLED=true

# --- Email (Gmail SMTP) ---
# 1) Enable 2-Step Verification on your Google Account
# 2) Create an App Password: Google Account → Security → App passwords
# 3) Paste the 16-character app password into SMTP_PASSWORD (no spaces)

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your.address@gmail.com
EMAIL_VERIFICATION_HOURS=24

# MySQL credentials live in database/db_config.env (gitignored).
# Tests only:
# EMAIL_PROVIDER=memory
# GURMADNET_DB=json
# ALLOW_TEST_EMAILS=true
