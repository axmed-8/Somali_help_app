# ============================================================
# GurmadNet environment template
# Copy to ".env" for local development:
#   copy .env.example .env
# Never commit the real .env file.
#
# On Render: set the same keys in the Environment dashboard.
# Production DB is Railway MySQL (public TCP proxy) — see render.yaml.
# Set MYSQL_PASSWORD in Render from Railway → MySQL → Variables.
# ============================================================

# --- REQUIRED (app will not start without these on Render) ---
SECRET_KEY=generate-a-long-random-value-here
GURMADNET_DB=mysql

# MySQL — REQUIRED for live app
# Local default (Windows MySQL80). For Render/production use Railway:
#   MYSQL_HOST=sakura.proxy.rlwy.net
#   MYSQL_PORT=33388
#   MYSQL_USER=root
#   MYSQL_DATABASE=railway
#   MYSQL_PASSWORD=<from Railway dashboard — never commit>
# Option A: discrete vars (preferred)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=gurmad

# Option B: single URL (also supported)
# DATABASE_URL=mysql://user:password@host:3306/gurmad
# MYSQL_URL=mysql://user:password@host:3306/gurmad

# Stability (Render → Railway proxy). Defaults are usually fine.
# MYSQL_CONNECT_TIMEOUT=10
# MYSQL_READ_TIMEOUT=30
# MYSQL_WRITE_TIMEOUT=30
# MYSQL_CONNECT_RETRIES=2
# MYSQL_SSL=auto   # auto|true|false — off for Railway *.proxy.rlwy.net (plain MySQL)

# Legacy aliases (optional — same meaning as MYSQL_*)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_NAME=gurmad

# --- App ---
APP_NAME=GurmadNet AI
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=false
WTF_CSRF_ENABLED=true
TRUST_PROXY=1

# --- Email (optional for boot; required for verification emails) ---
# On Render blueprint default is EMAIL_PROVIDER=memory until you set SMTP.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your.address@gmail.com
EMAIL_VERIFICATION_HOURS=24

# --- WebRTC ICE (optional; recommended for cross-network voice) ---
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=turn:your-turn-host:3478
WEBRTC_TURN_USERNAME=your-turn-username
WEBRTC_TURN_CREDENTIAL=your-turn-credential

# --- Optional ---
# GOOGLE_MAPS_API_KEY=
# AI_PROVIDER=rule_based
# OPENAI_API_KEY=

# Tests only:
# EMAIL_PROVIDER=memory
# GURMADNET_DB=json
# ALLOW_TEST_EMAILS=true
# TESTING=1
